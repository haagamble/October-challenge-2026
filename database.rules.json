{
  "rules": {
    ".read": false,
    ".write": false,
    "settingsOctober2026": {
      ".read": true,
      ".write": false
    },
    "groupChallengeOctober2026": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('settingsOctober2026/joinOpen').val() === true)",
        ".validate": "newData.hasChild('name')",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "entries": {
          "$date": {
            ".validate": "$date.matches(/^2026-10-(0[1-9]|[12][0-9]|3[01])$/) && (!newData.hasChild('rest') || (!newData.hasChild('selected') && !newData.hasChild('values') && !newData.hasChild('pullupType')))",
            "selected": {
              ".validate": "newData.hasChildren()",
              "$index": {
                ".validate": "$index.matches(/^[0-2]$/) && newData.isString() && newData.val().matches(/^(pushups|pullups|squats|situps|plank|walking|running|strength|dancing|stairs|bird-dog|other)$/)"
              }
            },
            "values": {
              "$activity": {
                ".validate": "$activity.matches(/^(pushups|pullups|squats|situps|plank|walking|running|strength|dancing|stairs|bird-dog|other)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999 && ($activity !== 'other' || newData.val() <= 100)"
              }
            },
            "$other": {
              ".validate": false
            },
            "rest": {
              ".validate": "newData.isBoolean() && newData.val() === true && $date.matches(/^2026-10-(0[1-9]|1[0-9]|2[0-8])$/)"
            },
            "pullupType": {
              ".validate": "newData.isString() && newData.val().matches(/^(full|modified)$/) && (newData.parent().child('selected/0').val() === 'pullups' || newData.parent().child('selected/1').val() === 'pullups' || newData.parent().child('selected/2').val() === 'pullups')"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cheerleaderScheduleOctober2026": {
      ".read": "auth != null",
      ".write": false
    },
    "cheerleaderClaimsOctober2026": {
      ".read": "auth != null",
      "$date": {
        ".write": "auth != null && root.child('groupChallengeOctober2026').child(auth.uid).exists() && root.child('cheerleaderScheduleOctober2026').child($date).child('uid').val() === auth.uid && root.child('cheerleaderScheduleOctober2026').child($date).child('startAt').isNumber() && root.child('cheerleaderScheduleOctober2026').child($date).child('endAt').isNumber() && now >= root.child('cheerleaderScheduleOctober2026').child($date).child('startAt').val() && now < root.child('cheerleaderScheduleOctober2026').child($date).child('endAt').val() && newData.exists()",
        ".validate": "$date.matches(/^2026-10-(0[1-9]|[12][0-9]|3[01])$/) && newData.hasChildren(['uid','status']) && (newData.child('status').val() !== 'claimed' || (data.child('uid').val() === auth.uid && (data.child('status').val() === 'accepted' || data.child('status').val() === 'claimed'))) && (newData.child('status').val() !== 'passed' || data.child('status').val() !== 'claimed')",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(accepted|passed|claimed)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
