 ($date === '2026-11-26' && now >= 1795680000000 && now < 1795766400000) || ($date === '2026-11-27' && now >= 1795766400000 && now < 1795852800000) || ($date === '2026-11-28' && now >= 1795852800000 && now < 1795939200000) || ($date === '2026-11-29' && now >= 1795939200000 && now < 1796025600000) || ($date === '2026-11-30' && now >= 1796025600000 && now < 1796112000000)) && (!data.child('rest').exists() || newData.child('rest').val() === true)"
